# Catálogo propuesto. P1 debe implementar y validar la configuración.
# No contiene credenciales reales. No es suficiente para arrancar una aplicación.
APP_ENV=development
DATABASE_TARGET=local
# PostgreSQL local (P1-T3): contenedor de compose.yaml en 127.0.0.1:55432, nunca el 5432 de
# Postgres.app. Elegí contraseñas locales nuevas y repetí las de los roles dentro de cada URL.
# Las guardas de packages/db rechazan otro host, puerto, rol o base.
POSTGRES_PASSWORD=
SISTEMA_CHATBOT_DEV_PASSWORD=
SISTEMA_CHATBOT_TEST_PASSWORD=
DATABASE_URL=postgresql://sistema_chatbot_dev:<contraseña-dev>@127.0.0.1:55432/sistema_chatbot_dev
TEST_DATABASE_URL=postgresql://sistema_chatbot_test:<contraseña-test>@127.0.0.1:55432/sistema_chatbot_test
ADMIN_ORIGIN=http://localhost:5173
API_PORT=4000
CHANNEL_MODE=simulator
EMAIL_MODE=capture
STORAGE_MODE=local_private
SCANNER_MODE=fake_development_only
MAX_FILE_BYTES=10485760
MAX_FILES_PER_SUBMISSION=1
DOCUMENT_RETENTION_DAYS=30
WORKER_CONCURRENCY=4
# Ajustar según implementación. Producción debe rechazar modos fake/capture de éxito simulado.
WHATSAPP_GRAPH_API_VERSION=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=
EMAIL_RECIPIENT_ALLOWLIST=
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
