# Catálogo propuesto. P1 debe implementar y validar la configuración.
# No contiene credenciales reales. No es suficiente para arrancar una aplicación.
APP_ENV=development
DATABASE_TARGET=local
# PostgreSQL local (P1-T3): contenedor de compose.yaml en 127.0.0.1:55432, nunca el 5432 de
# Postgres.app. Elegí contraseñas locales nuevas y repetí las de los roles dentro de cada URL.
# Las guardas de packages/db rechazan otro host, puerto, rol o base.
POSTGRES_PASSWORD=
SISTEMA_CHATBOT_DEV_PASSWORD=
SISTEMA_CHATBOT_TEST_PASSWORD=
DATABASE_URL=postgresql://sistema_chatbot_dev:<contraseña-dev>@127.0.0.1:55432/sistema_chatbot_dev
TEST_DATABASE_URL=postgresql://sistema_chatbot_test:<contraseña-test>@127.0.0.1:55432/sistema_chatbot_test
ADMIN_ORIGIN=http://localhost:5173
# API (P1-T4): en P1 solo escucha en loopback. Sesiones de 30 min de inactividad y 8 h en total.
API_HOST=127.0.0.1
API_PORT=4000
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=8
CHANNEL_MODE=simulator
EMAIL_MODE=capture
STORAGE_MODE=local_private
SCANNER_MODE=fake_development_only
# Archivos (ADR-014 §11). Cupo histórico de candidatos por trámite: cuenta todo candidato creado,
# incluidos rechazados y purgados, y no se devuelve. El adjunto por envío es fijo (1) en la DSL.
# Bytes exactos: 10 MiB = 10485760 por archivo; 30 MiB = 31457280 almacenados por trámite.
# Las aplica el host en P2; reemplazan a MAX_FILES_PER_SUBMISSION, que se retiró por ambigua.
MAX_FILE_BYTES=10485760
MAX_CANDIDATE_FILES_PER_SUBMISSION=3
MAX_CANDIDATE_BYTES_PER_SUBMISSION=31457280
DOCUMENT_RETENTION_DAYS=30
WORKER_CONCURRENCY=4
# Ajustar según implementación. Producción debe rechazar modos fake/capture de éxito simulado.
WHATSAPP_GRAPH_API_VERSION=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=
EMAIL_RECIPIENT_ALLOWLIST=
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
