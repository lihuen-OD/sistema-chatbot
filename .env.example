# Catálogo propuesto. P1 debe implementar y validar la configuración.
# No contiene credenciales reales. No es suficiente para arrancar una aplicación.
APP_ENV=development
DATABASE_TARGET=local
DATABASE_URL=postgresql://chatbot_dev:local_only_password@localhost:5432/chatbot_dev
ADMIN_ORIGIN=http://localhost:5173
API_PORT=4000
CHANNEL_MODE=simulator
EMAIL_MODE=capture
STORAGE_MODE=local_private
SCANNER_MODE=fake_development_only
MAX_FILE_BYTES=10485760
MAX_FILES_PER_SUBMISSION=1
DOCUMENT_RETENTION_DAYS=30
WORKER_CONCURRENCY=4
