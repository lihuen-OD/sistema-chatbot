{
  "schemaVersion": 1,
  "ruleSetId": "routing_demo_v1",
  "defaultBehavior": "REQUIRES_REVIEW",
  "rules": [
    {
      "id": "rule_company_a_accounting",
      "all": [
        {
          "variable": "company",
          "operator": "eq",
          "value": "company_a"
        },
        {
          "variable": "documentType",
          "operator": "eq",
          "value": "invoice"
        }
      ],
      "recipientGroupIds": [
        "company_a_accounting"
      ],
      "classification": "GENERAL"
    },
    {
      "id": "rule_company_a_hr",
      "all": [
        {
          "variable": "company",
          "operator": "eq",
          "value": "company_a"
        },
        {
          "variable": "documentType",
          "operator": "eq",
          "value": "medical_certificate"
        }
      ],
      "recipientGroupIds": [
        "company_a_hr"
      ],
      "classification": "SENSITIVE_HR"
    },
    {
