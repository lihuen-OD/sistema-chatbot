{
  "schemaVersion": 1,
  "ruleSetId": "routing_demo",
  "version": 1,
  "contextVariables": {
    "company": {
      "type": "companyRef"
    },
    "documentType": {
      "type": "documentTypeRef"
    }
  },
  "defaultBehavior": "REQUIRES_REVIEW",
  "reviewOnly": [],
  "rules": [
    {
      "id": "rule_company_a_accounting",
      "all": [
        {
          "variable": "company",
          "operator": "eq",
          "value": "company_a"
        },
        {
          "variable": "documentType",
          "operator": "eq",
          "value": "invoice"
        }
      ],
      "targetGroupIds": [
        "company_a_accounting"
      ]
    },
    {
      "id": "rule_company_a_hr",
      "all": [
        {
          "variable": "company",
          "operator": "eq",
          "value": "company_a"
        },
        {
          "variable": "documentType",
          "operator": "eq",
          "value": "medical_certificate"
        }
      ],
      "targetGroupIds": [
        "company_a_hr"
      ]
    },
    {
      "id": "rule_company_b_accounting",
      "all": [
        {
          "variable": "company",
          "operator": "eq",
          "value": "company_b"
        },
        {
          "variable": "documentType",
          "operator": "eq",
          "value": "invoice"
        }
      ],
      "targetGroupIds": [
        "company_b_accounting"
      ]
    },
    {
      "id": "rule_company_b_hr",
      "all": [
        {
          "variable": "company",
          "operator": "eq",
          "value": "company_b"
        },
        {
          "variable": "documentType",
          "operator": "eq",
          "value": "medical_certificate"
        }
      ],
      "targetGroupIds": [
        "company_b_hr"
      ]
    }
  ]
}
