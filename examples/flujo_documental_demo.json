{
  "schemaVersion": 1,
  "flowId": "document_demo",
  "name": "Recepción documental de demostración",
  "variables": {
    "company": {
      "type": "companyRef"
    },
    "documentType": {
      "type": "documentTypeRef"
    },
    "documents": {
      "type": "documentRefList"
    }
  },
  "entryNodeId": "start",
  "nodes": [
    {
      "id": "start",
      "type": "start",
      "next": "company"
    },
    {
      "id": "company",
      "type": "selection",
      "text": "¿Para qué empresa enviás el documento?",
      "variable": "company",
      "optionsSource": {
        "kind": "AUTHORIZED_COMPANIES"
      },
      "maxOptions": 10,
      "autoSelectSingle": false,
      "next": "document_type",
      "onEmpty": "no_scope"
    },
    {
      "id": "document_type",
      "type": "selection",
      "text": "¿Qué documento vas a enviar?",
      "variable": "documentType",
      "options": [
        {
          "id": "opt_invoice",
          "label": "Factura",
          "value": "invoice",
          "next": "upload"
        },
        {
          "id": "opt_medical",
          "label": "Certificado médico",
          "value": "medical_certificate",
          "next": "upload"
        }
      ]
    },
    {
      "id": "upload",
      "type": "file",
      "text": "Adjuntá un único archivo PDF, JPG o PNG de hasta 10 MB.",
      "variable": "documents",
      "allowedMimeTypes": [
        "application/pdf",
        "image/jpeg",
        "image/png"
      ],
      "maxBytes": 10485760,
      "minCount": 1,
      "maxCount": 1,
      "review": {
        "text": "Vas a enviar {{fileName}} ({{fileType}}, {{fileSize}}) como {{documentType}} para {{company}}. ¿Confirmás el envío? Si la empresa o el tipo no son correctos, elegí Cancelar y empezá de nuevo.",
        "confirmLabel": "Confirmar",
        "replaceLabel": "Reemplazar",
        "cancelLabel": "Cancelar"
      },
      "next": "email"
    },
    {
      "id": "email",
      "type": "email",
      "ruleSetId": "routing_demo",
      "contextVariables": [
        "company",
        "documentType"
      ],
      "subject": "Documento recibido: {{documentType}}",
      "body": "Se recibió un documento para {{company}}.",
      "documentVariable": "documents",
      "continueOn": "EMAIL_ACCEPTED",
      "next": "confirmation"
    },
    {
      "id": "confirmation",
      "type": "message",
      "text": "Tu documento fue procesado y el proveedor de correo aceptó el envío. Si necesitás corregirlo, escribí CORREGIR.",
      "next": "end"
    },
    {
      "id": "end",
      "type": "end",
      "reason": "COMPLETED"
    },
    {
      "id": "no_scope",
      "type": "message",
      "text": "No tenés empresas habilitadas para enviar documentos. Consultá con tu área de personal.",
      "next": "end_no_scope"
    },
    {
      "id": "end_no_scope",
      "type": "end",
      "reason": "NO_AUTHORIZED_SCOPE"
    }
  ]
}
